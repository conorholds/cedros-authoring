{
  "name": "@cedros/authoring",
  "version": "0.1.0",
  "description": "Build custom pages, themes, and extensions for your Cedros website",
  "license": "MIT-0",
  "homepage": "https://github.com/conorholds/cedros-authoring#readme",
  "bugs": {
    "url": "https://github.com/conorholds/cedros-authoring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conorholds/cedros-authoring.git"
  },
  "keywords": [
    "cedros",
    "agent",
    "scaffold",
    "cms",
    "themes",
    "extensions",
    "custom-pages"
  ],
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "bin": {
    "cedros-authoring": "tooling/bin/cedros-authoring.mjs"
  },
  "files": [
    "docs",
    "tooling",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "help": "node ./tooling/bin/cedros-authoring.mjs --help",
    "page": "node ./tooling/bin/cedros-authoring.mjs init page",
    "theme": "node ./tooling/bin/cedros-authoring.mjs init theme",
    "extension": "node ./tooling/bin/cedros-authoring.mjs init extension"
  },
  "publishConfig": {
    "access": "public"
  }
}
