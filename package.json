{
  "name": "@cedros/authoring",
  "version": "0.1.0",
  "description": "Cedros scaffolds and agent guidance for custom pages, themes, and extensions",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/conorholds/cedros-authoring#readme",
  "bugs": {
    "url": "https://github.com/conorholds/cedros-authoring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conorholds/cedros-authoring.git"
  },
